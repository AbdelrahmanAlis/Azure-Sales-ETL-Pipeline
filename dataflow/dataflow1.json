{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "salesdata",
						"type": "DatasetReference"
					},
					"name": "Sales"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "DropNullOrderID"
				},
				{
					"name": "DataProcessing"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "sort1"
				},
				{
					"name": "surrogateKey1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select2"
				},
				{
					"name": "FillNumbers"
				},
				{
					"name": "Averages"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter2"
				},
				{
					"name": "select3"
				},
				{
					"name": "computeTotalAmount"
				},
				{
					"name": "RenameColumn"
				}
			],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          order_date as string,",
				"          customer_id as string,",
				"          product as string,",
				"          category as string,",
				"          quantity as string,",
				"          unit_price as string,",
				"          {Total Amount} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Sales",
				"Sales filter(!isNull(order_id)) ~> DropNullOrderID",
				"RenameColumn derive(order_date = iif(\r",
				"    isNull(order_date) || trim(order_date) == '',\r",
				"    toDate('2020-01-01'),\r",
				"    coalesce(\r",
				"        toDate(order_date, 'M/d/yyyy'),\r",
				"        toDate(order_date, 'MM/dd/yyyy'),\r",
				"        toDate(order_date, 'yyyy/MM/dd'),\r",
				"        toDate(order_date, 'yyyy-MM-dd'),\r",
				"        toDate(order_date, 'MMMM d yyyy')\r",
				"    )\r",
				"),",
				"          category = 'Electronics',",
				"          customer_id = iifNull(toInteger(regexReplace(customer_id, '[^0-9]', '')), -1),",
				"          unit_price = toDouble(unit_price),",
				"          quantity = toInteger(quantity)) ~> DataProcessing",
				"DataProcessing aggregate(groupBy(product),",
				"     product_count = count()) ~> aggregate1",
				"aggregate1 sort(desc(product_count, true)) ~> sort1",
				"sort1 keyGenerate(output(SurrogateKey as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 filter(SurrogateKey == 1) ~> filter1",
				"DataProcessing, select2 join(true()==true(),",
				"     joinType:'cross',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"filter1 select(mapColumn(",
				"          Most_Popular_Product = product",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"Averages derive(product = iifNull(product, Most_Popular_Product),",
				"          unit_price = iif(isNull(unit_price) || quantity <= 0, avg_unit_price, unit_price),",
				"          quantity = iif(isNull(quantity) || quantity <= 0, avg_quantity, quantity)) ~> FillNumbers",
				"join1 window(avg_quantity = toInteger(round(avg(toInteger(quantity)))),",
				"          avg_unit_price = round(avg(unit_price), 2)) ~> Averages",
				"computeTotalAmount window(over(order_id),",
				"     desc(order_date, true),",
				"     final_row_num = rowNumber()) ~> window1",
				"window1 filter(final_row_num == 1) ~> filter2",
				"filter2 select(mapColumn(",
				"          order_id,",
				"          order_date,",
				"          customer_id,",
				"          product,",
				"          category,",
				"          quantity,",
				"          unit_price,",
				"          total_amount",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"FillNumbers derive(total_amount = unit_price * quantity) ~> computeTotalAmount",
				"DropNullOrderID select(mapColumn(",
				"          order_id,",
				"          order_date,",
				"          customer_id,",
				"          product,",
				"          category,",
				"          quantity,",
				"          unit_price,",
				"          total_amount = {Total Amount}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameColumn",
				"select3 sink(allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     input(",
				"          order_id as integer,",
				"          order_date as date,",
				"          customer_id as integer,",
				"          product as string,",
				"          category as string,",
				"          quantity as integer,",
				"          unit_price as decimal(18,0),",
				"          total_amount as decimal(18,0)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}